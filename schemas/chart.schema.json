{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://december-capital.github.io/konta-rulebook/schemas/chart.schema.json",
  "title": "Konta chart of accounts",
  "description": "An immutable, effective-dated version of a published chart of accounts, transcribed from the act. Classes, groups, synthetic accounts (gradul I) and subaccounts (gradul II), each named as the act names it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "jurisdiction",
    "title",
    "effectiveFrom",
    "publishedOn",
    "status",
    "sources",
    "classes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^md-pgcc-[0-9]{4}(\\.[0-9]+)?$",
      "description": "md-pgcc-<year the version took force>, e.g. md-pgcc-2020, or md-pgcc-2020.2 for a later amendment in force the same year."
    },
    "jurisdiction": {
      "type": "string",
      "enum": [
        "MD"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "effectiveFrom": {
      "type": "string",
      "format": "date",
      "description": "First date this version governs."
    },
    "effectiveTo": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Last date this version governs. Null while it is the current version."
    },
    "publishedOn": {
      "type": "string",
      "format": "date",
      "description": "When WE published this version."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "superseded"
      ]
    },
    "approvedBy": {
      "type": "string",
      "minLength": 1
    },
    "approvedOn": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "ruleset.schema.json#/properties/sources/items"
      }
    },
    "translations": {
      "type": "object",
      "additionalProperties": false,
      "description": "Where the names in another language come from. A language listed here has a name on every class, group, account and subaccount (nameRu for ru); one not listed has none.",
      "properties": {
        "ru": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceIndexes"
          ],
          "properties": {
            "sourceIndexes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "integer",
                "minimum": 0
              },
              "description": "The sources holding the Russian text: the act that states the names, then each amendment applied to them."
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    },
    "closing": {
      "type": "object",
      "additionalProperties": false,
      "description": "The closing entries at the end of the reporting period, as the act states them. The product reads the classes and accounts from here; every movement carries its sentence.",
      "required": [
        "incomeClasses",
        "expenseClasses",
        "resultAccount",
        "netResultAccount",
        "movements",
        "resultHasNoBalance"
      ],
      "properties": {
        "notes": {
          "type": "string"
        },
        "incomeClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]$"
          }
        },
        "expenseClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]$"
          }
        },
        "managementClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]$"
          }
        },
        "resultAccount": {
          "type": "string",
          "pattern": "^[0-9]{3}$"
        },
        "netResultAccount": {
          "type": "string",
          "pattern": "^[0-9]{3}$"
        },
        "movements": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/closingMovement"
          }
        },
        "resultHasNoBalance": {
          "$ref": "#/$defs/citation"
        },
        "managementAccountsFirst": {
          "$ref": "#/$defs/citation"
        }
      }
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/class"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "approvedBy",
          "approvedOn"
        ]
      }
    }
  ],
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^\\S(.*\\S)?$"
    },
    "class": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "section",
        "doubleEntry",
        "accountsMandatory",
        "entityMayAdd"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[1-9]$"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "nameRu": {
          "$ref": "#/$defs/name",
          "description": "The name in the act's Russian text, as published in Monitorul Oficial's Russian edition. Present on every node or on none, as translations.ru says."
        },
        "section": {
          "enum": [
            "bilanț",
            "rezultate",
            "gestiune",
            "extrabilanțier"
          ],
          "description": "Balance sheet, results (income and expenses), management, or off-balance."
        },
        "nature": {
          "enum": [
            "activ",
            "pasiv"
          ],
          "description": "Chapter I's general rule for the class: the side of its accounts, contra accounts excepted. Absent for a single-entry class. What an account the entity adds to the class sits on."
        },
        "doubleEntry": {
          "type": "boolean",
          "description": "False for off-balance accounts, which are kept in single entry with no corresponding account."
        },
        "accountsMandatory": {
          "type": "boolean",
          "description": "Whether the synthetic accounts are obligatory. Subaccounts are always recommendations."
        },
        "entityMayAdd": {
          "type": "array",
          "items": {
            "enum": [
              "accounts",
              "subaccounts"
            ]
          },
          "uniqueItems": true,
          "description": "What an entity may add to this class in its own working chart."
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/group"
          }
        },
        "accounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/account"
          },
          "description": "Accounts directly under the class, for a class the act does not divide into groups (class 9)."
        },
        "note": {
          "type": "string"
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "accounts"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[1-9][0-9]$"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "nameRu": {
          "$ref": "#/$defs/name",
          "description": "The name in the act's Russian text, as published in Monitorul Oficial's Russian edition. Present on every node or on none, as translations.ru says."
        },
        "accounts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/account"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[1-9][0-9]{2}$"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "nameRu": {
          "$ref": "#/$defs/name",
          "description": "The name in the act's Russian text, as published in Monitorul Oficial's Russian edition. Present on every node or on none, as translations.ru says."
        },
        "nature": {
          "enum": [
            "activ",
            "pasiv"
          ],
          "description": "activ: increases on the debit, balance on the debit. pasiv: increases on the credit, balance on the credit. Absent for single-entry accounts."
        },
        "qualifier": {
          "enum": [
            "rectificativ",
            "calculație",
            "colectare – repartizare"
          ],
          "description": "rectificativ: a contra account, reducing the value of another."
        },
        "natureFrom": {
          "enum": [
            "account",
            "class",
            "general-rule"
          ],
          "description": "Where the nature is stated: the account's own sentence, its class's opening, or the act's general rule for its class."
        },
        "confidence": {
          "enum": [
            "verified",
            "unverified"
          ],
          "description": "Set on an account when it is less certain than the rest of the version, and once a human has read it."
        },
        "history": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The act's own amendment notes for this account, verbatim."
        },
        "subaccounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subaccount"
          }
        },
        "note": {
          "type": "string"
        }
      },
      "dependentRequired": {
        "nature": [
          "natureFrom"
        ],
        "natureFrom": [
          "nature"
        ]
      }
    },
    "subaccount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[1-9][0-9]{3}$"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "nameRu": {
          "$ref": "#/$defs/name",
          "description": "The name in the act's Russian text, as published in Monitorul Oficial's Russian edition. Present on every node or on none, as translations.ru says."
        },
        "note": {
          "type": "string"
        }
      }
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceIndex",
        "article",
        "page",
        "quote"
      ],
      "description": "Where the act says it: the source, its chapter and account, the physical page, and the sentence word for word.",
      "properties": {
        "sourceIndex": {
          "type": "integer",
          "minimum": 0
        },
        "article": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "quote": {
          "type": "string",
          "minLength": 20
        }
      }
    },
    "closingMovement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "debit",
        "credit",
        "source"
      ],
      "description": "One movement of the closing: income into the result, the result against expenses, and the result to the net profit or loss. debit and credit are a class code (one digit) or an account code.",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "income",
            "expenses",
            "profit",
            "loss"
          ]
        },
        "debit": {
          "type": "string",
          "pattern": "^[0-9]{1,3}$"
        },
        "credit": {
          "type": "string",
          "pattern": "^[0-9]{1,3}$"
        },
        "source": {
          "$ref": "#/$defs/citation"
        }
      }
    }
  }
}
