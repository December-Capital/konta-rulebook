{
  "about": "Payroll vectors for the 2026 rules: one employee, month by month, by the cumulative method of HG 697/2014. Each case runs its months in order from the start of the year; a month's year-to-date is the sum of the months before it. The rules are not repeated here: whoever runs the vectors reads them from this rulebook as of asOf (md-2026), so a value that changes there fails the vectors until they are recomputed and checked again. Amounts are lei as decimal strings with two decimals. Read by konta (backend/tests/Konta.Golden.Tests/PayrollVectorsTests.cs, over Konta.Domain.Payroll.PayrollArithmetic) and by konta-www (tools/test-salary.mjs, over assets/salary.js, the konta.md salary calculator), which must agree to the ban.",
  "asOf": "2026-01-31",
  "method": "cumulative",
  "fields": {
    "gross": "the month's salary",
    "personalMonths": "months of the year through this one the personal exemption is owed for",
    "dependantMonths": "dependant-months owed through this one",
    "medical": "CNAM premium withheld",
    "exemption": "exemptions granted this month (negative when the personal exemption is withdrawn)",
    "taxable": "this month's share of the year's taxable income",
    "incomeTax": "income tax withheld",
    "net": "paid to the employee",
    "social": "the employer's CNAS contribution"
  },
